# Copiez ce fichier en .env.local. Ne partagez jamais les clés dans le chat.
# Sans clé : recherche locale et extraits exacts, sans génération IA.
OPENAI_API_KEY=
CHAT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
# Facultatif en développement ; obligatoire pour les appels IA en production.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Origine publique exacte après déploiement (sans slash final).
APP_ORIGIN=http://localhost:3000
# Secret aléatoire de 32 caractères minimum pour pseudonymiser les quotas.
QUOTA_SECRET=
AI_ENABLED=false
DAILY_AI_REQUEST_LIMIT=100
SESSION_HOURLY_REQUEST_LIMIT=20
# Synthèses IA par adresse IP et par jour ; au-delà, extraits officiels sans IA.
AI_IP_DAILY_LIMIT=10
# Proxy Vercel uniquement. Aucun en-tête IP arbitraire n'est accepté hors Vercel.
# L'exemple limite les appels IA ; il ne constitue pas un budget en euros.
